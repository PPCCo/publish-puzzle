# Copy selected values into your shell or secret manager. Do not commit .env.
PUBLISHING_EXTERNAL_WRITES=disabled
PUBLISHING_DEFAULT_LOCALE=en-US
PUBLISHING_TIMEZONE=America/New_York
PUBLISHING_PYTHON=python3
