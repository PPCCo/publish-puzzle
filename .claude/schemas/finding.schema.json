{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "reviewer_role",
    "artifact_id",
    "artifact_hash",
    "severity",
    "dimension",
    "location",
    "observation",
    "evidence",
    "recommendation",
    "acceptance_test",
    "status",
    "confidence"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^fnd-[a-z0-9-]+$"
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor",
        "note"
      ]
    },
    "dimension": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_test": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "rejected-with-rationale",
        "fixed-awaiting-verification",
        "closed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resolution_notes": {
      "type": "string"
    }
  }
}
