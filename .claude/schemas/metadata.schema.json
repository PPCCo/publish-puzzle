{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Product Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "language",
    "contributors",
    "audience",
    "description",
    "keywords",
    "subjects",
    "edition",
    "rights_statement",
    "formats"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "short_description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "edition": {
      "type": "integer",
      "minimum": 1
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "rights_statement": {
      "type": "string",
      "minLength": 1
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": true
    },
    "pricing": {
      "type": "object",
      "additionalProperties": true
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
