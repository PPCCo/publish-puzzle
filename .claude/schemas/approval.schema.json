{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "project_id",
    "gate",
    "approver",
    "approver_role",
    "decision",
    "artifact_hashes",
    "scope",
    "created_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^apr-[a-z0-9-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "string",
      "enum": [
        "niche",
        "interior",
        "cover",
        "compliance",
        "listing",
        "release"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "approver_role": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED"
      ]
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "invalidated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "invalidation_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
