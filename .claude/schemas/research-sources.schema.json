{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-sources.schema.json",
  "title": "Research Sources & Retrieval Tiers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "search", "sources"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "host", "tier"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "enum": ["http", "browser"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host", "tiers", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "host": { "type": "string", "minLength": 1 },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["http", "browser", "assisted", "manual"] }
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "paywalled": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "manual_platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "url", "good_for"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "good_for": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
