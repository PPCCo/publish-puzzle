{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publishing Project",
  "description": "A puzzle / coloring / journal / printable product project. book_type names the PRODUCT FAMILY; product_type is a convenience alias.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "working_title",
    "topic",
    "book_type",
    "audience",
    "language",
    "formats",
    "edition",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "working_title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "book_type": {
      "type": "string",
      "enum": [
        "puzzle-book",
        "activity-book",
        "coloring-book",
        "guided-journal",
        "workbook",
        "planner",
        "digital-printable"
      ]
    },
    "product_type": {
      "type": "string",
      "enum": [
        "puzzle-book",
        "activity-book",
        "coloring-book",
        "guided-journal",
        "workbook",
        "planner",
        "digital-printable"
      ]
    },
    "genre": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "kids-4-8",
        "kids-6-10",
        "tween-8-12",
        "teen-13-17",
        "adult-general",
        "senior-large-print"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "paperback",
          "hardcover",
          "digital-pdf"
        ]
      }
    },
    "sales_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "kdp",
          "etsy",
          "gumroad",
          "generic"
        ]
      }
    },
    "edition": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "puzzle_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_content_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "difficulty_progression": {
          "type": "string"
        },
        "solutions_placement": {
          "type": "string",
          "enum": [
            "back-only",
            "inline",
            "none"
          ]
        }
      }
    },
    "series": {
      "description": "Back-reference linking this product to a series manifest under series/<series_id>/. Absent for standalone products.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "position"
      ],
      "properties": {
        "series_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "total_planned": {
          "type": "integer",
          "minimum": 1
        },
        "prior_project_ids": {
          "description": "Project IDs of earlier products in the set whose covered material this product may assume. Read-only sibling context; never written to.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
          }
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": true
    },
    "commercial": {
      "type": "object",
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "additionalProperties": true
    },
    "status_notes": {
      "type": "string"
    }
  }
}
