{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "time",
    "event",
    "project_id",
    "actor",
    "details"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
